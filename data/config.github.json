{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "category": "llm-inference",
        "profile": "tech-blog"
      },
      {
        "name": "SemiAnalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "Semiconductor industry",
        "url": "https://news.google.com/rss/search?q=semiconductor%20TSMC%20ASML%20Infineon&hl=en-US&gl=US&ceid=US%3Aen",
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "Germany education and DAAD",
        "url": "https://news.google.com/rss/search?q=DAAD%20Germany%20universities%20international%20students&hl=en-US&gl=US&ceid=US%3Aen",
        "category": "germany-education",
        "profile": "tech-news"
      },
      {
        "name": "Germany chip industry",
        "url": "https://news.google.com/rss/search?q=Germany%20semiconductor%20Infineon%20Dresden&hl=en-US&gl=US&ceid=US%3Aen",
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "category": "finance",
        "profile": "finance-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 15,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {
      "ai": {
        "name": "AI / Technology",
        "limit": 5,
        "categories": [
          "ai-tools",
          "llm-inference",
          "github-trending"
        ]
      },
      "semiconductors": {
        "name": "Semiconductors",
        "limit": 5,
        "categories": [
          "semiconductors"
        ]
      },
      "germany": {
        "name": "Germany / Universities",
        "limit": 3,
        "categories": [
          "germany-education"
        ]
      },
      "finance": {
        "name": "Business / Economy",
        "limit": 3,
        "categories": [
          "finance"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
}
