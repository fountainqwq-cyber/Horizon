{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "personal-ai",
    "profile_settings": {
      "personal-ai": {
        "threshold": 6,
        "topic_dedup": true
      },
      "personal-chips": {
        "threshold": 6,
        "topic_dedup": true
      },
      "personal-electronics": {
        "threshold": 7,
        "topic_dedup": true
      },
      "personal-germany": {
        "threshold": 6,
        "topic_dedup": true
      },
      "personal-business": {
        "threshold": 6,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "category": "ai",
        "profile": "personal-ai",
        "content_extractor": "article"
      },
      {
        "name": "EE Times",
        "url": "https://www.eetimes.com/feed/",
        "category": "semiconductors",
        "profile": "personal-chips",
        "content_extractor": "article"
      },
      {
        "name": "NVIDIA official blog",
        "url": "https://blogs.nvidia.com/feed/",
        "category": "semiconductors",
        "profile": "personal-chips",
        "content_extractor": "article"
      },
      {
        "name": "IT Home industry reports (strict trend filter)",
        "url": "https://www.ithome.com/rss/",
        "category": "consumer-electronics",
        "profile": "personal-electronics",
        "content_extractor": "article"
      },
      {
        "name": "Germany study opportunities",
        "url": "https://news.google.com/rss/search?q=(DAAD%20OR%20%22study%20in%20Germany%22%20OR%20%22German%20universities%22)%20(scholarship%20OR%20admission%20OR%20tuition%20OR%20%22international%20students%22)%20when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "category": "germany-education",
        "profile": "personal-germany"
      },
      {
        "name": "CNBC business and economy",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "category": "finance",
        "profile": "personal-business",
        "content_extractor": "article"
      },
      {
        "name": "TrendForce industry research",
        "url": "https://www.trendforce.com/news/feed/",
        "category": "consumer-electronics",
        "profile": "personal-electronics"
      },
      {
        "name": "Consumer electronics market research discovery",
        "url": "https://news.google.com/rss/search?q=(smartphone%20OR%20PC%20OR%20wearable)%20(shipments%20OR%20%22market%20share%22%20OR%20inventory)%20(IDC%20OR%20Counterpoint%20OR%20Omdia%20OR%20Canalys)%20when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "category": "consumer-electronics",
        "profile": "personal-electronics",
        "content_extractor": "article"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 10,
    "profile_order": [
      "personal-ai",
      "personal-chips",
      "personal-electronics",
      "personal-germany",
      "personal-business"
    ],
    "category_groups": {
      "ai": {
        "name": "AI 产品与产业",
        "limit": 3,
        "categories": [
          "ai"
        ]
      },
      "semiconductors": {
        "name": "半导体产业",
        "limit": 2,
        "categories": [
          "semiconductors"
        ]
      },
      "consumer-electronics": {
        "name": "消费电子行业趋势",
        "limit": 2,
        "categories": [
          "consumer-electronics"
        ]
      },
      "germany-education": {
        "name": "德国留学",
        "limit": 1,
        "categories": [
          "germany-education"
        ]
      },
      "finance": {
        "name": "商业与经济",
        "limit": 2,
        "categories": [
          "finance"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  },
  "extractors": {
    "article": {
      "type": "trafilatura",
      "favor_precision": true
    }
  }
}
